{
 "format": "prompt-conditions-corpus",
 "version": 1,
 "kind": "evaluate",
 "describes": "template + resolved variable values -> text after conditions are decided; branch bodies are not sampled (no {a|b}/${x} expansion); errors lists the error kinds in offset order",
 "case_fields": {
  "name": "unique id",
  "template": "prompt text",
  "values": "variable name -> resolved value string; absent = undefined",
  "expected": "text",
  "errors": "error kinds in offset order"
 },
 "cases": [
  {
   "name": "true_branch",
   "template": "a <<if $x = \"y\">>B<<end>> c",
   "values": {
    "x": "y"
   },
   "expected": "a B c",
   "errors": []
  },
  {
   "name": "false_without_else_closes_the_gap",
   "template": "a <<if $x = \"y\">>B<<end>> c",
   "values": {
    "x": "z"
   },
   "expected": "a c",
   "errors": []
  },
  {
   "name": "else_branch",
   "template": "a <<if $x = \"y\">>B<<else>>E<<end>> c",
   "values": {
    "x": "z"
   },
   "expected": "a E c",
   "errors": []
  },
  {
   "name": "else_if_chain_second_wins",
   "template": "<<if $x = \"a\">>A<<else if $x = \"b\">>B<<else if $x = \"c\">>C<<else>>Z<<end>>",
   "values": {
    "x": "b"
   },
   "expected": "B",
   "errors": []
  },
  {
   "name": "else_if_chain_first_true_wins",
   "template": "<<if $x = \"b\">>A<<else if $x = \"b\">>B<<end>>",
   "values": {
    "x": "b"
   },
   "expected": "A",
   "errors": []
  },
  {
   "name": "else_if_whitespace_tolerant",
