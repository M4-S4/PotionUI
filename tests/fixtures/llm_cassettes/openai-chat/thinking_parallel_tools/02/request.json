{
  "method": "POST",
  "url": "http://vllm.local:8000/v1/chat/completions",
  "headers": {
    "Content-Type": "application/json",
    "Authorization": "[scrubbed]"
  },
  "body": {
    "model": "Qwen/Qwen3-30B-A3B",
    "messages": [
      {
        "role": "system",
        "content": "You are a preset assistant."
      },
      {
        "role": "user",
        "content": "Which preset is faster, fast or slow?"
      },
      {
        "role": "assistant",
        "content": "",
        "tool_calls": [
          {
            "id": "chatcmpl-tool-aa11",
            "type": "function",
            "function": {
              "name": "get_preset",
              "arguments": "{\"name\": \"fast\"}"
            }
          },
          {
            "id": "chatcmpl-tool-bb22",
            "type": "function",
            "function": {
              "name": "get_preset",
              "arguments": "{\"name\": \"slow\"}"
            }
          }
        ],
        "reasoning": "Both presets need to be read."
      },
      {
        "role": "tool",
        "content": "{\"name\":\"fast\",\"steps\":4}",
        "tool_call_id": "chatcmpl-tool-aa11",
        "name": "get_preset"
      },
      {
        "role": "tool",
        "content": "{\"name\":\"slow\",\"steps\":30}",
        "tool_call_id": "chatcmpl-tool-bb22",
        "name": "get_preset"
      }
    ],
    "temperature": 0.7,
    "max_completion_tokens": 2000,
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_preset",
          "description": "Read one preset by name",
          "parameters": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    ]
  }
}
