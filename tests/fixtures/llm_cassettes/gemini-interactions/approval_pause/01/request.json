      {
        "type": "function",
        "name": "list_backups",
        "description": "List the stored backups.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      {
        "type": "function",
        "name": "delete_backup",
        "description": "Delete one stored backup permanently.",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        }
      }
    ],
    "generation_config": {
      "temperature": 1.0,
      "max_output_tokens": 4096,
      "thinking_summaries": "auto"
    }
  }
}
