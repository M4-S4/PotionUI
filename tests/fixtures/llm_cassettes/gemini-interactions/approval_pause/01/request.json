{
  "method": "POST",
  "url": "https://generativelanguage.googleapis.com/v1beta/interactions",
  "headers": {
    "x-goog-api-key": "[scrubbed]",
    "content-type": "application/json"
  },
  "body": {
    "model": "gemini-3.8-flash",
    "input": [
      {
        "type": "user_input",
        "content": [
          {
            "type": "text",
            "text": "Remove my stale backups."
          }
        ]
      }
    ],
    "store": false,
    "stream": true,
    "system_instruction": "You help manage backups. Ask before destructive actions.",
