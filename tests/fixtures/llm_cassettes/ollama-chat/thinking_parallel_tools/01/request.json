{
  "method": "POST",
  "url": "http://ollama.local:11434/api/chat",
  "headers": {
    "Content-Type": "application/json",
    "Authorization": "[scrubbed]"
  },
  "body": {
    "model": "qwen3:8b",
    "messages": [
      {
        "role": "system",
        "content": "You are a preset assistant."
      },
      {
        "role": "user",
        "content": "Which preset is faster, fast or slow?"
      }
    ],
    "stream": true,
    "keep_alive": 0,
    "think": true,
    "options": {
      "temperature": 0.7,
      "num_predict": 2000
    },
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_preset",
          "description": "Read one preset by name",
          "parameters": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    ]
  }
}
