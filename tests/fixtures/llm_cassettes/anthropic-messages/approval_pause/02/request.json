{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "anthropic-version": "2026-10-21",
    "x-api-key": "[scrubbed]",
    "content-type": "application/json",
    "accept": "text/event-stream"
  },
  "body": {
    "model": "claude-sonnet-5-5",
    "max_tokens": 8192,
    "stream": true,
    "system": "You are a careful file assistant. Ask before destructive actions.",
    "thinking": {
      "type": "adaptive"
    },
    "output_config": {
      "effort": "medium"
    },
    "cache_control": {
      "type": "ephemeral"
    },
    "tools": [
      {
        "name": "read_file",
        "description": "Read a text file.",
        "input_schema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "delete_file",
        "description": "Delete a file or folder.",
        "input_schema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Show me README.md and then remove the build/ folder."
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "thinking",
            "thinking": "Reading is safe. Deleting build/ needs the user's approval.",
            "signature": "ErUBCkYIARgCIkB-hand-built-pause-signature-1"
          },
          {
            "type": "text",
            "text": "Reading the README and preparing the deletion."
          },
          {
            "type": "tool_use",
            "id": "toolu_01HandBuiltRead",
            "name": "read_file",
            "input": {
              "path": "README.md"
            }
          },
          {
            "type": "tool_use",
            "id": "toolu_01HandBuiltDelete",
            "name": "delete_file",
            "input": {
              "path": "build/"
            }
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "tool_result",
            "tool_use_id": "toolu_01HandBuiltRead",
            "content": [
              {
                "type": "text",
                "text": "# PotionUI\nSelf-hosted generation."
              }
            ]
          },
          {
            "type": "tool_result",
            "tool_use_id": "toolu_01HandBuiltDelete",
            "content": [
              {
                "type": "text",
                "text": "The user declined this action: delete_file build/."
              }
            ],
            "is_error": true
          }
        ]
      }
    ]
  }
}
