{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "anthropic-version": "2026-10-21",
    "x-api-key": "[scrubbed]",
    "content-type": "application/json",
    "accept": "text/event-stream"
  },
  "body": {
    "model": "claude-sonnet-5-5",
    "max_tokens": 1024,
    "stream": true,
    "system": "You are a helpful assistant.",
    "cache_control": {
      "type": "ephemeral"
    },
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hello"
          }
        ]
      }
    ]
  }
}
