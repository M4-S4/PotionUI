{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "anthropic-version": "2026-10-21",
    "x-api-key": "[scrubbed]",
    "content-type": "application/json",
    "accept": "text/event-stream"
  },
  "body": {
    "model": "claude-sonnet-5-5",
    "max_tokens": 8192,
    "stream": true,
    "system": "You are a travel assistant. Use the tools to answer.",
    "thinking": {
      "type": "adaptive"
    },
    "output_config": {
      "effort": "medium"
    },
    "cache_control": {
      "type": "ephemeral"
    },
    "tools": [
      {
        "name": "get_weather",
        "description": "Current weather for a city.",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ]
        }
      },
      {
        "name": "get_time",
        "description": "Current local time for a city.",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ]
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "What is the weather in Paris and Tokyo, and what time is it in Tokyo?"
          }
        ]
      }
    ]
  }
}
