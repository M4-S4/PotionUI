# Windows clones default to core.autocrlf=true; shell scripts must stay LF
# (bash rejects CRLF, and Docker Desktop builds read them from the checkout),
# while the batch launcher is happiest with CRLF.
potionui text eol=lf
*.sh text eol=lf
potionui.cmd text eol=crlf
content/plugins/*/*/frontend/** text=auto eol=lf
content/plugins/sdk/** text=auto eol=lf
content/plugins/*/*/frontend/dist/** text eol=lf
content/plugins/*/*/frontend/src/** text eol=lf
